# Required
OPENAI_API_KEY=

# Optional — enables live mandi price data from data.gov.in
MANDI_API_KEY=

# Qdrant — defaults work for local Docker, override for Qdrant Cloud
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=kisan_schemes
# QDRANT_API_KEY=

# PostgreSQL — only needed for mandi price caching
# DATABASE_URL=postgresql+asyncpg://kisan:kisan123@localhost:5432/kisan
